# Copy to .env for local Docker Compose use. Never commit real secrets.
MYSQL_ROOT_PASSWORD=replace-with-local-root-password
MYSQL_DATABASE=rentflow
MYSQL_USER=rentflow
MYSQL_PASSWORD=replace-with-local-service-password

RABBITMQ_DEFAULT_USER=rentflow
RABBITMQ_DEFAULT_PASS=replace-with-local-rabbitmq-password

IDENTITY_DB_USER=rentflow_identity
IDENTITY_DB_PASSWORD=replace-with-local-identity-password
COMPANY_DB_USER=rentflow_company
COMPANY_DB_PASSWORD=replace-with-local-company-password
FLEET_DB_USER=rentflow_fleet
FLEET_DB_PASSWORD=replace-with-local-fleet-password
RENTAL_DB_USER=rentflow_rental
RENTAL_DB_PASSWORD=replace-with-local-rental-password

JWT_ISSUER=rentflow
JWT_AUDIENCE=rentflow-api
JWT_SECRET=replace-with-at-least-32-character-local-development-secret
INTERNAL_PROVISIONING_KEY=replace-with-local-internal-provisioning-key
DEMO_SEED_PASSWORD=replace-with-local-demo-password
